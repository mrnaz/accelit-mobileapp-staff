# The ADMIN host — whatever APP_ADMIN_URL names in the backend.
#
# For a phone this must be a host the phone can actually resolve and reach over
# the VPN, i.e. the real staging or production host. A local .test domain will
# not work: it resolves only on the machine running Valet/dnsmasq, and pointing
# at that machine's LAN IP instead 404s, because the API's routes are bound to
# the admin domain and would see the wrong Host header.
#
#   phone / real use   EXPO_PUBLIC_API_URL=https://app.accelit.online
#   simulator on this mac  EXPO_PUBLIC_API_URL=http://app.accelit.test
EXPO_PUBLIC_API_URL=https://app.accelit.online
